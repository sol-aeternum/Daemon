+@dataclass(slots=True)
+class BenchmarkResetSummary:
+    """Structured summary returned by :func:`reset_canonical_benchmark`.
+
+    All fields are serializable to JSON so the caller can persist the
+    artifact alongside benchmark results.
+    """
+
+    user_id: str
+    tables_cleared: dict[str, int]
+    total_rows_deleted: int
+    checkpoint_reset: dict[str, Any]
+    redis_cleanup: dict[str, Any]
+    reset_timestamp: str
+    success: bool
+    error: str | None
+
+
+async def reset_canonical_benchmark(
+    pool: asyncpg.Pool,
+    checkpoint_path: Path,
+    *,
+    cleanup_redis: bool = True,
+) -> BenchmarkResetSummary:
+    """Reset all canonical LongMemEval benchmark state so a fresh run
+    cannot carry over evidence from a prior run.
+
+    This helper is the **only** mechanism for deterministic canonical
+    benchmark resets.  It:
+
+    1. Deletes every row associated with the shared ``TEST_USER_ID``
+       from the seven core tables that can hold benchmark evidence.
+    2. Removes the checkpoint file so the runner cannot skip work by
+       resuming from a stale completed-phase entry.
+    3. Optionally deletes Redis extraction/ARQ keys to prevent queued
+       background jobs from writing evidence after the harness believes
+       teardown is complete.
+
+    Parameters
+    ----------
+    pool
+        An open ``asyncpg.Pool`` connected to the Daemon database.
+    checkpoint_path
+        Path to the runner checkpoint file.  If it exists it will be
+        deleted unconditionally.
+    cleanup_redis
+        When True (default), delete Redis extraction-job keys.  Pass
+        False when Redis is not available or not in use.
+
+    Returns
+    -------
+    BenchmarkResetSummary
+        A structured summary suitable for logging, metrics capture, or
+        persisting as a benchmark artifact.  The ``success`` field is
+        True only when every step completed without error.
+    """
+    summary = BenchmarkResetSummary(
+        user_id=str(TEST_USER_ID),
+        tables_cleared={},
+        total_rows_deleted=0,
+        checkpoint_reset={},
+        redis_cleanup={},
+        reset_timestamp=utc_now_iso(),
+        success=True,
+        error=None,
+    )
+
+    # 1. Database cleanup
+    try:
+        summary.tables_cleared = await cleanup_canonical_benchmark_state(pool)
+        summary.total_rows_deleted = sum(summary.tables_cleared.values())
+    except Exception as exc:
+        summary.success = False
+        summary.error = f"db cleanup failed: {exc}"
+        return summary
+
+    # 2. Checkpoint invalidation
+    try:
+        summary.checkpoint_reset = reset_runner_checkpoint(checkpoint_path)
+    except Exception as exc:
+        summary.success = False
+        summary.error = f"checkpoint reset failed: {exc}"
+        return summary
+
+    # 3. Redis cleanup (best-effort)
+    if cleanup_redis:
+        try:
+            summary.redis_cleanup = await cleanup_runner_redis()
+        except Exception as exc:  # pragma: no-cover
+            # Redis is not critical to benchmark correctness; log and continue
+            summary.redis_cleanup = {"keys_deleted": 0, "error": str(exc)}
+
+    return summary
