+
+# Patterns matched when cleaning Redis extraction keys.
+_REDIS_EXTRACT_PATTERNS = (
+    "extract:*",
+    "arq:job:extract:*",
+    "arq:result:extract:*",
+    "arq:retry:extract:*",
+)
+
+
+async def cleanup_canonical_benchmark_state(pool: asyncpg.Pool) -> dict[str, int]:
+    """Delete all benchmark-user rows from the core Daemon tables.
+
+    This is the canonical-lane equivalent of the fast-lane
+    ``cleanup_benchmark_state()`` in
+    ``orchestrator/eval/longmemeval_fast.py``.  It targets the
+    shared ``TEST_USER_ID`` that the canonical runner uses for all
+    corpus sessions.
+
+    Returns a dict of ``table_name → deleted_count`` for the seven
+    tables that can carry benchmark evidence across runs.
+    """
+    user_id = TEST_USER_ID
+    deleted: dict[str, int] = {}
+    tables = [
+        "retrieval_log",
+        "dream_log",
+        "entities",
+        "memories",
+        "memory_extraction_log",
+        "messages",
+        "conversations",
+    ]
+    async with pool.acquire() as conn:
+        for table in tables:
+            result = await conn.execute(
+                f"DELETE FROM {table} WHERE user_id = $1", user_id
+            )
+            # Execute returns e.g. "DELETE 5" or "DELETE 0"
+            count_str = result.split()[-1] if result else "0"
+            deleted[table] = int(count_str)
+    return deleted
+
+
+def reset_runner_checkpoint(checkpoint_path: Path) -> dict[str, Any]:
+    """Remove the checkpoint file so the next canonical run cannot resume
+    from stale phase results.
+
+    Returns a dict describing what was found and whether a file existed.
+    """
+    existed = checkpoint_path.exists()
+    if existed:
+        checkpoint_path.unlink()
+    return {
+        "checkpoint_path": str(checkpoint_path),
+        "checkpoint_existed": existed,
+        "checkpoint_removed": existed,
+    }
+
+
+async def cleanup_runner_redis() -> dict[str, Any]:
+    """Delete Redis keys used by the extraction pipeline.
+
+    Clears keys matching the ARQ extraction job patterns so that no
+    stale queued-extraction state can bleed into the next run.
+
+    Returns a dict with ``keys_deleted`` (total count) and any error.
+    """
+    try:
+        import redis
+    except Exception as exc:
+        return {"keys_deleted": 0, "error": f"redis unavailable: {exc}"}
+
+    def _scan_delete(client: Any, pattern: str) -> int:
+        count = 0
+        cursor = 0
+        while True:
+            scan_result = client.scan(cursor=cursor, match=pattern, count=500)
+            if isinstance(scan_result, tuple) and len(scan_result) == 2:
+                cursor, keys = scan_result
+                if keys:
+                    count += client.delete(*keys)
+            else:
+                break
+            if cursor == 0:
+                break
+        return count
+
+    try:
+        settings = get_settings()
+        redis_url = getattr(settings, "redis_url", None) or "redis://localhost:6379/0"
+        client = redis.Redis.from_url(redis_url, decode_responses=True)
+        total = sum(_scan_delete(client, p) for p in _REDIS_EXTRACT_PATTERNS)
+        return {"keys_deleted": total, "error": None}
+    except Exception as exc:
+        return {"keys_deleted": 0, "error": str(exc)}
+
