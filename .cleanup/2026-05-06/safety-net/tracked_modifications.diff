+def create_advisor_registry() -> ToolRegistry:
+    """Create the minimal advisor-safe tool registry.
+
+    Advisors can only use offline/local-safe tools: get_time and calculate.
+    This prevents recursive consult_advisor calls or escalation to spawn tools.
