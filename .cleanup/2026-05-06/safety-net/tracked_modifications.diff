+# ---------------------------------------------------------------------------
+# Rolling 50-question hard-abort (Task 8)
+# ---------------------------------------------------------------------------
+
+class HardAbortError(Exception):
+    """Raised when the rolling 50-question window success rate drops below 50%%."""
+
+    pass
+
+
+# Failure category constants for raw-result classification
+_FAILURE_CATEGORY_PROVIDER_ERROR = "provider error"
+_FAILURE_CATEGORY_TIMEOUT = "timeout"
+_FAILURE_CATEGORY_MALFORMED_EMPTY = "malformed/empty answer"
+_FAILURE_CATEGORY_HARNESS_EXCEPTION = "harness exception"
+_FAILURE_CATEGORY_JUDGE_ERROR = "judge/evaluation error"
+_FAILURE_CATEGORY_ROLLING_ABORT = "rolling-window abort"
+
+
+def _classify_failure_category(result: dict[str, Any]) -> str:
+    """Classify a raw result row into a failure category.
+
+    This categorizes answer-call level failures, NOT judged accuracy.
+    Categories match the Task 5 / wave0_closure_routing_audit.md §14 contract.
+    """
+    error = result.get("error")
+    hypothesis = result.get("hypothesis", "")
+    judgment = result.get("judgment", "")
+
+    # Error present: classify by error type (before checking success)
+    if error is not None:
+        error_lower = error.lower()
+        if any(kw in error_lower for kw in ("timeout", "timed out", "asyncio.timeouterror")):
+            return _FAILURE_CATEGORY_TIMEOUT
+        if any(
+            kw in error_lower
+            for kw in (
+                "rate",
+                "limit",
+                "auth",
+                "unauthorized",
+                "forbidden",
+                "not found",
+                "model not found",
+                "badrequesterror",
+                "bad request",
+                "openrouterexception",
+                "rate_limit",
+                "429",
+                "403",
+                "401",
+            )
+        ):
+            return _FAILURE_CATEGORY_PROVIDER_ERROR
+        return _FAILURE_CATEGORY_HARNESS_EXCEPTION
+
+    # No error: check hypothesis presence
+    if hypothesis == "":
+        return _FAILURE_CATEGORY_MALFORMED_EMPTY
+
+    # No error, non-empty hypothesis: check judge availability
+    # judgment == "" here means answer-call succeeded but judge failed
+    if judgment == "":
+        return _FAILURE_CATEGORY_JUDGE_ERROR
+
+    # Successful answer-call: non-empty hypothesis, no error, judgment present
+    return ""
+
+
+def _is_answer_call_success(result: dict[str, Any]) -> bool:
+    """Return True when the result represents a successful answer-call completion.
+
+    Success means: hypothesis is non-empty AND no harness error was raised.
+    A result with judgment == "incorrect" but a valid hypothesis is still a success.
+    """
+    return result.get("hypothesis", "") != "" and result.get("error") is None
+
+
+def _check_rolling_abort(
+    rolling_window: deque[tuple[str, bool]],
+) -> None:
+    """Check the rolling window and raise HardAbortError if success rate < 50%%.
+
+    Called after each result is appended to the window. The window is
+    sized at exactly 50 entries (deque(maxlen=50) ensures this).
+    An abort fires when the success rate over the full 50-entry window
+    drops below 0.50 (i.e., fewer than 25 successes).
+    """
+    if len(rolling_window) < 50:
+        return
+    successes = sum(1 for _, is_success in rolling_window if is_success)
+    if successes < 25:  # < 50% of 50
+        raise HardAbortError(
+            f"Rolling 50-question window abort: {successes}/50 successes "
+            f"({successes / 50:.0%}) below 50%% threshold"
+        )
+
