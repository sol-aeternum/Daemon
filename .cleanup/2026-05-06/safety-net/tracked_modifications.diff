+)
+
+
+def _load_0edc2aef_from_artifact() -> dict[str, Any]:
+    if not FAILURE_ANALYSIS_ARTIFACT.exists():
+        pytest.skip(
+            f"Artifact not found: {FAILURE_ANALYSIS_ARTIFACT} "
+            "(run benchmark to produce it, or ensure repo is not sparse)"
+        )
+    raw = json.loads(FAILURE_ANALYSIS_ARTIFACT.read_text())
+    entry = next(e for e in raw if e.get("question_id") == "0edc2aef")
+    return entry
+
+
+def _build_session_from_ground_truth(ground_truth: str) -> list[dict[str, str]]:
+    user_pref_turn = (
+        "I prefer hotels with great views, especially if they overlook the ocean "
+        "or the city skyline. I also really like unique features like a rooftop pool "
+        "or a hot tub on the balcony. Budget hotels without those features don't "
+        "appeal to me."
+    )
+    assistant_ack_turn = (
+        "Great, those are helpful preferences! Based on what you've described, "
+        "you'd enjoy hotels in Miami that offer ocean or skyline views along with "
+        "distinctive amenities like rooftop pools or balcony hot tubs."
+    )
+    return [
+        {
+            "role": "user",
+            "content": "I'm planning a trip to Miami. Can you suggest a hotel?",
+        },
+        {
+            "role": "assistant",
+            "content": "Of course! What matters most to you in a hotel?",
+        },
+        {"role": "user", "content": user_pref_turn},
+        {"role": "assistant", "content": assistant_ack_turn},
+        {"role": "user", "content": "Those sound perfect."},
+    ]
+
+
+ARTIFACT_0EDC2AEF = _load_0edc2aef_from_artifact()
+ARTIFACT_GROUND_TRUTH = ARTIFACT_0EDC2AEF["ground_truth"]
+ARTIFACT_CHUNK_COUNT_OLD = ARTIFACT_0EDC2AEF["chunk_count"]
+
+FACTS_FROM_GROUND_TRUTH = ["great views", "rooftop pool", "hot tub on the balcony"]
+
+ARTIFACT_HAYSTACK_ENTRY = {
+    "question_id": "0edc2aef",
+    "haystack_session_ids": ["session_miami_pref"],
+    "haystack_sessions": [_build_session_from_ground_truth(ARTIFACT_GROUND_TRUTH)],
+}
+
+
+def test_chunk_0edc2aef_artifact_entry_loads() -> None:
+    assert ARTIFACT_0EDC2AEF["question_id"] == "0edc2aef"
+    assert ARTIFACT_0EDC2AEF["original_judgment"] == "partially_correct"
+    assert ARTIFACT_0EDC2AEF["memories_returned"] == 0
+    assert ARTIFACT_0EDC2AEF["chunk_count"] == 341
+    assert "great views" in ARTIFACT_GROUND_TRUTH.lower()
+
+
+def test_chunk_0edc2aef_ground_truth_facts_identified() -> None:
+    for fact in FACTS_FROM_GROUND_TRUTH:
+        assert fact in ARTIFACT_GROUND_TRUTH.lower(), (
+            f"Fact {fact!r} not found in ground_truth from artifact"
+        )
+
+
+def test_chunk_0edc2aef_preference_facts_cooccur_in_one_chunk() -> None:
+    chunks = build_question_chunks(
+        ARTIFACT_HAYSTACK_ENTRY,
+        max_chars=DEFAULT_CHUNK_MAX_CHARS,
+        overlap_turns=DEFAULT_OVERLAP_TURNS,
+    )
+    assert len(chunks) >= 1
+    matching_chunks = [
+        c
+        for c in chunks
+        if all(fact.lower() in c.content.lower() for fact in FACTS_FROM_GROUND_TRUTH)
+    ]
+    assert len(matching_chunks) >= 1, (
+        f"Preference facts {FACTS_FROM_GROUND_TRUTH!r} did not co-occur in any chunk. "
+        f"Chunks produced:\n"
+        + "\n---\n".join(f"[chunk {i}] {c.content[:500]}" for i, c in enumerate(chunks))
+    )
+
+
+def test_chunk_0edc2aef_max_chars_is_4000() -> None:
+    assert DEFAULT_CHUNK_MAX_CHARS == 4000
+
+
+def test_chunk_0edc2aef_overlap_is_2_turns() -> None:
+    assert DEFAULT_OVERLAP_TURNS == 2
