+def _flatten_config(value: Any, *, prefix: str = "") -> dict[str, Any]:
+    if isinstance(value, dict):
+        flattened: dict[str, Any] = {}
+        for key, nested_value in value.items():
+            nested_prefix = f"{prefix}.{key}" if prefix else str(key)
+            flattened.update(_flatten_config(nested_value, prefix=nested_prefix))
+        return flattened
+    if isinstance(value, list):
+        flattened = {}
+        for index, nested_value in enumerate(value):
+            nested_prefix = f"{prefix}[{index}]"
+            flattened.update(_flatten_config(nested_value, prefix=nested_prefix))
+        return flattened
+    return {prefix: value}
+
+
+def describe_benchmark_config_drift(
+    pinned_config: dict[str, Any], effective_config: dict[str, Any]
+) -> list[str]:
+    pinned_flat = _flatten_config(pinned_config)
+    effective_flat = _flatten_config(effective_config)
+    warnings: list[str] = []
+
+    for key in sorted(pinned_flat.keys() - effective_flat.keys()):
+        warnings.append(f"missing effective config value for {key}")
+    for key in sorted(effective_flat.keys() - pinned_flat.keys()):
+        warnings.append(f"unexpected effective config value for {key}")
+    for key in sorted(pinned_flat.keys() & effective_flat.keys()):
+        if pinned_flat[key] != effective_flat[key]:
+            warnings.append(
+                f"{key}: pinned={pinned_flat[key]!r} effective={effective_flat[key]!r}"
+            )
+    return warnings
+
+
+def _load_pinned_benchmark_config(pin_path: Path) -> dict[str, Any]:
+    payload = read_json(pin_path)
+    if not isinstance(payload, dict):
+        raise ValueError(f"Benchmark config pin must be a JSON object: {pin_path}")
+    return payload
+
