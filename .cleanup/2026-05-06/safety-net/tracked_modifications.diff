+        if "retrieval_log" in query:
+            self._deleted["retrieval_log"] = 5
+            return "DELETE 5"
+        if "dream_log" in query:
+            self._deleted["dream_log"] = 2
+            return "DELETE 2"
+        if "entities" in query:
+            self._deleted["entities"] = 3
+            return "DELETE 3"
+        if "memories" in query:
+            self._deleted["memories"] = 10
+            return "DELETE 10"
+        if "memory_extraction_log" in query:
+            self._deleted["memory_extraction_log"] = 4
+            return "DELETE 4"
+        if "messages" in query:
+            self._deleted["messages"] = 20
+            return "DELETE 20"
+        if "conversations" in query:
+            self._deleted["conversations"] = 7
+            return "DELETE 7"
+        return "DELETE 0"
+
+    def acquire(self) -> FakePoolAcquire:
+        return FakePoolAcquire(self._deleted)
+
+    async def close(self) -> None:
+        pass
+
+
+class FakeConn:
+    def __init__(self, deleted: dict[str, int]) -> None:
+        self._deleted = deleted
+
+    async def execute(self, query: str, *args: object) -> str:
+        for table in self._deleted:
+            if table in query:
+                self._deleted[table] = 1
+                return f"DELETE 1"
+        return "DELETE 0"
+
+    async def __aenter__(self) -> "FakeConn":
+        return self
+
+    async def __aexit__(self, *args: object) -> None:
+        pass
+
