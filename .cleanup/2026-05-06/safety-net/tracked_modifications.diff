+        elapsed = time_module.monotonic() - t0
+
+        # Extract model and fingerprint from response
+        response_data: Any = response
+        model_dump = getattr(response, "model_dump", None)
+        if callable(model_dump):
+            response_data = model_dump()
+        else:
+            dict_method = getattr(response, "dict", None)
+            if callable(dict_method):
+                response_data = dict_method()
+
+        seen_model = response_data.get("model")
+        seen_fingerprint = response_data.get("system_fingerprint")
+        content = ""
+        choices = response_data.get("choices", [])
+        if choices:
+            message = choices[0].get("message", {})
+            if isinstance(message, dict):
+                content = message.get("content", "") or ""
+            else:
+                content = getattr(message, "content", "") or ""
+
+        if not content:
+            raise PreflightError(
+                f"[PREFLIGHT FAIL] Answer model returned empty content. "
+                f"model={model_to_probe!r} provider.order=[{endpoint_slug!r}] "
+                f"failure_mode=empty_response elapsed={elapsed:.2f}s"
+            )
+
+        logger.info(
+            "[preflight] Answer-model pre-flight PASSED: "
+            "model=%s fingerprint=%s provider.order=[%s] elapsed=%.2fs",
+            seen_model,
+            seen_fingerprint,
+            endpoint_slug,
+            elapsed,
+        )
+
+        return {
+            "preflight": "passed",
+            "model": seen_model,
+            "fingerprint": seen_fingerprint,
+            "provider_order": [endpoint_slug],
+            "latency_s": round(elapsed, 2),
+            "preflight_override_used": bool(preflight_override),
+        }
+
+    except PreflightError:
+        raise
+    except Exception as exc:
+        elapsed = time_module.monotonic() - t0
+        raise PreflightError(
+            f"[PREFLIGHT FAIL] Answer-model pre-flight FAILED. "
+            f"call_site=runner.evaluate() model={model_to_probe!r} "
+            f"provider.order=[{endpoint_slug!r}] "
+            f"failure_mode={type(exc).__name__}: {exc} "
+            f"elapsed={elapsed:.2f}s"
+        ) from exc
