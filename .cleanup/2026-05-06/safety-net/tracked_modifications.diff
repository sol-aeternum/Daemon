+def build_effective_benchmark_config(
+    *,
+    dataset_path: Path | None,
+    checkpoint_dataset_path: str | None,
+    output_path: Path,
+    checkpoint_path: Path,
+    score_path: Path,
+    limit: int | None,
+    force_retrieval_logging: bool,
+    benchmark_mode: bool = BENCHMARK_MODE,
+    settings: Any | None = None,
+    pin_path: Path = BENCHMARK_CONFIG_PIN_PATH,
+) -> dict[str, Any]:
+    effective_dataset_path = (
+        str(dataset_path)
+        if dataset_path is not None
+        else checkpoint_dataset_path
+    )
+    return {
+        "lane": "canonical",
+        "pin_path": str(pin_path),
+        "runtime": {
+            "dataset_path": effective_dataset_path,
+            "limit": limit,
+            "output_path": str(output_path),
+            "checkpoint_path": str(checkpoint_path),
+            "score_path": str(score_path),
+            "force_retrieval_logging": force_retrieval_logging,
+            "benchmark_mode": benchmark_mode,
+        },
+        "pinned_authority": build_longmemeval_pinned_config(settings=settings),
+    }
+
+
+def attach_effective_benchmark_config(
+    checkpoint: dict[str, Any],
+    *,
+    dataset_path: Path | None,
+    output_path: Path,
+    checkpoint_path: Path,
+    score_path: Path,
+    limit: int | None,
+    force_retrieval_logging: bool,
+    benchmark_mode: bool = BENCHMARK_MODE,
+    settings: Any | None = None,
+    pin_path: Path = BENCHMARK_CONFIG_PIN_PATH,
+) -> dict[str, Any]:
+    effective_config = build_effective_benchmark_config(
+        dataset_path=dataset_path,
+        checkpoint_dataset_path=checkpoint.get("dataset_path"),
+        output_path=output_path,
+        checkpoint_path=checkpoint_path,
+        score_path=score_path,
+        limit=limit,
+        force_retrieval_logging=force_retrieval_logging,
+        benchmark_mode=benchmark_mode,
+        settings=settings,
+        pin_path=pin_path,
+    )
+
+    warnings: list[str] = []
+    try:
+        pinned_config = _load_pinned_benchmark_config(pin_path)
+        warnings = describe_benchmark_config_drift(
+            pinned_config,
+            effective_config["pinned_authority"],
+        )
+    except FileNotFoundError:
+        warnings = [f"benchmark config pin missing: {pin_path}"]
+    except ValueError as exc:
+        warnings = [str(exc)]
+
+    checkpoint["benchmark_effective_config"] = effective_config
+    checkpoint["benchmark_config_drift_warnings"] = warnings
+
+    if warnings:
+        logger.warning(
+            "LongMemEval benchmark config drift detected vs %s: %s",
+            pin_path,
+            "; ".join(warnings),
+        )
+    return checkpoint
+
