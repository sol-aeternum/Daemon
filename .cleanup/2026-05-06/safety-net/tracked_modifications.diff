+def _effective_mode_value(
+    section: dict[str, Any],
+    field: str,
+    *,
+    benchmark_mode: bool,
+) -> Any:
+    if benchmark_mode:
+        benchmark_section = section.get("benchmark_mode")
+        if isinstance(benchmark_section, dict) and field in benchmark_section:
+            return benchmark_section.get(field)
+    return section.get(field)
