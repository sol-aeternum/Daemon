+async def _query_retrieval_logs_for_metrics(
+    pool: asyncpg.Pool,
+    user_id: uuid.UUID,
+) -> list[dict[str, Any]]:
+    rows = await pool.fetch(
+        """
+        SELECT
+            rl.id,
+            rl.query_text,
+            rl.latency_ms,
+            rl.selected_memory_ids,
+            rl.l0_included,
+            rl.candidate_memory_ids,
+            rl.created_at
+        FROM retrieval_log rl
+        WHERE rl.user_id = $1
+        ORDER BY rl.created_at ASC
+        """,
+        user_id,
+    )
+    return [dict(r) for r in rows]
+
+
+async def _query_memory_counts_for_metrics(
+    pool: asyncpg.Pool,
+    user_id: uuid.UUID,
+) -> dict[str, int]:
+    row = await pool.fetchrow(
+        """
+        SELECT
+            COUNT(*) FILTER (WHERE status = 'active') AS active_count,
+            COUNT(*) FILTER (WHERE status = 'historical') AS historical_count,
+            COUNT(*) AS total_count
+        FROM memories
+        WHERE user_id = $1
+        """,
+        user_id,
+    )
+    return {
+        "active": row["active_count"] or 0,
+        "historical": row["historical_count"] or 0,
+        "total": row["total_count"] or 0,
+    }
+
+
+def _extract_outcome(status: str) -> str:
+    if status in ("completed", "complete"):
+        return "completed"
+    if status == "extraction_failed":
+        return "errored"
+    if status == "extraction_timeout":
+        return "timed_out"
+    if status == "error":
+        return "errored"
+    return "unknown"
+
