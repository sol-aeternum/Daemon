+def _normalize_openrouter_model_id(model_id: str) -> str:
+    """Normalize model IDs to the repository's OpenRouter-first convention."""
+
+    normalized = model_id.strip()
+    if not normalized:
+        return normalized
+
+    if normalized.startswith("openrouter/"):
+        return normalized
+    if normalized.startswith("opencode/"):
+        return f"openrouter/{normalized[len('opencode/') :]}"
+    return f"openrouter/{normalized}"
+
+
+def _validate_tool_call_compatibility(label: str, model_id: str) -> str:
+    """Validate that a model exposes the tool-calling params used on `/chat`."""
+
+    import litellm
+
+    normalized_model = _normalize_openrouter_model_id(model_id)
+    if not normalized_model:
+        raise ValueError(f"{label} model is empty")
+
+    try:
+        raw_supported_params = litellm.get_supported_openai_params(
+            model=normalized_model
+        )
+    except Exception as exc:  # pragma: no cover - defensive error path
+        raise ValueError(
+            f"{label} model '{normalized_model}' failed LiteLLM compatibility probe: {exc}"
+        ) from exc
+
+    supported_params: set[str] = set()
+    if raw_supported_params:
+        supported_params = {str(param) for param in raw_supported_params}
+
+    if not supported_params:
+        raise ValueError(
+            f"{label} model '{normalized_model}' is not recognized by LiteLLM"
+        )
+
+    missing_params = [
+        param
+        for param in TOOL_CALL_COMPATIBILITY_PARAMS
+        if param not in supported_params
+    ]
+    if missing_params:
+        raise ValueError(
+            f"{label} model '{normalized_model}' is missing tool-calling params: {', '.join(missing_params)}"
+        )
+
+    return normalized_model
+
