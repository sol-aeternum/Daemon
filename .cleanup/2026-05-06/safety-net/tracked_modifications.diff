+def retry_advisor_hint(domain: str | None = None) -> dict[str, str]:
+    """Build an advisory system message hint for retry-triggered advisor escalation.
+
+    This hint is injected into the conversation to bias the executor toward
+    consulting an advisor when the user has corrected or requested a different
+    version of the previous output. The executor remains free to ignore the hint.
+
+    Args:
+        domain: Optional domain hint (coding, graphics, reasoning, research, general).
+               If None, a generic hint is used.
+
+    Returns:
+        A dict with role='system' and content for injection into messages.
+    """
+    if domain and domain in ("coding", "graphics", "reasoning", "research", "general"):
+        hint_text = (
+            f"Your previous response was corrected or a different version was requested. "
+            f"This request is in the [{domain}] domain. "
+            f"Consider consulting an advisor for this domain if you are uncertain about the best approach. "
+            f"The advisor can provide focused guidance before you proceed."
+        )
+    else:
+        hint_text = (
+            "Your previous response was corrected or a different version was requested. "
+            "Consider consulting an advisor if you are uncertain about the best approach. "
+            "The advisor can provide focused guidance before you proceed."
+        )
+
+    return {"role": "system", "content": hint_text}
