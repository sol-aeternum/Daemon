+def load_standalone_ingest_results(
+    corpus_plan: CorpusPlan,
+    question_id: str | None = None,
+) -> dict[str, dict[str, Any]]:
+    """Load and validate standalone ingest results from the well-known output file.
+
+    This bridge is needed when ``evaluate`` runs after standalone ingest (via
+    ``python -m orchestrator.eval.longmemeval ingest``) rather than after
+    ``runner.ingest()``.  The standalone script writes its results to
+    ``/tmp/longmemeval_ingestion_results.json`` but does not update the runner
+    checkpoint; this function reads that file and re-indexes it by corpus_key
+    so it can be merged into the checkpoint ingest results.
+
+    Parameters
+    ----------
+    corpus_plan
+        The corpus plan for the current run, used to validate that the
+        standalone file contains entries for all corpus keys referenced by
+        the question being evaluated (in targeted mode) or all corpus keys
+        (in full-corpus mode).
+    question_id
+        When set, validates only the corpus keys referenced by this question.
+        When None, validates all corpus keys in the corpus plan.
+
+    Returns
+    -------
+    dict[str, dict[str, Any]]
+        A mapping from corpus_key to the corresponding result dict, suitable
+        for merging into checkpoint["phases"]["ingest"]["results"].  Returns
+        an empty dict if the file does not exist or is not a list.
+    """
+    if not STANDALONE_INGEST_RESULTS_PATH.exists():
+        return {}
+
+    try:
+        with open(STANDALONE_INGEST_RESULTS_PATH) as f:
+            raw_results = json.load(f)
+    except Exception:
+        return {}
+
+    if not isinstance(raw_results, list):
+        return {}
+
+    by_corpus_key: dict[str, dict[str, Any]] = {}
+    for entry in raw_results:
+        if not isinstance(entry, dict):
+            continue
+        corpus_key = entry.get("corpus_key")
+        if not isinstance(corpus_key, str) or not corpus_key:
+            continue
+        by_corpus_key[corpus_key] = entry
+
+    # Validate coverage:
+    # - Targeted mode (question_id set): validate only that question's corpus keys.
+    # - Full-corpus mode (question_id=None): validate ALL corpus keys in the plan.
+    # Raising here means the standalone file is incomplete and we must not proceed
+    # with unfiltered retrieval — better to fail loudly than produce unscoped results.
+    if question_id is not None:
+        corpus_keys = corpus_plan.question_corpus_refs.get(question_id, ())
+        missing = [ck for ck in corpus_keys if ck not in by_corpus_key]
+    else:
+        all_corpus_keys = [cs.corpus_key for cs in corpus_plan.corpus_sessions]
+        missing = [ck for ck in all_corpus_keys if ck not in by_corpus_key]
+
+    if missing:
+        raise RuntimeError(
+            "Standalone ingest file is missing entries for "
+            + ("this question's" if question_id is not None else "full-corpus")
+            + " required corpus keys: "
+            + ", ".join(missing[:10])
+            + (" ..." if len(missing) > 10 else "")
+        )
+
+    return by_corpus_key
+
