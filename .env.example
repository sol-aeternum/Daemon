# Default provider for LLM calls
# Options: venice, openrouter, opencode_zen, or custom provider name
DEFAULT_PROVIDER=openrouter

# Request and stream settings
REQUEST_TIMEOUT_S=90
STREAM_PING_INTERVAL_S=15

# Development: stream canned responses without calling any provider
MOCK_LLM=false

# Runtime
ENV=dev
LOG_LEVEL=INFO

# Tier-1 Recommended Models for Primary Daemon Orchestration
# Comma-separated list of model IDs (without veniceai/ prefix)
# These models appear first in /v1/models and are marked as "recommended"
# Benchmark tier: claude-opus-45, kimi-k2-5, kimi-k2-thinking
TIER1_MODELS=claude-opus-45,kimi-k2-5,kimi-k2-thinking

# ================================================
# OpenRouter (Multi-provider gateway)
# https://openrouter.ai/docs
# ================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LITELLM_MODEL=openrouter/anthropic/claude-opus-4.6

# ================================================
# OpenCode Zen (OpenAI-compatible endpoint)
# https://opencode.ai/docs/zen/
# ================================================
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=opencode/claude-opus-4-6

# ================================================
# Custom Provider Configuration
# Add any provider by setting PROVIDER_{NAME}_* variables
# Example for a custom OpenAI-compatible provider:
# ================================================
# PROVIDER_CUSTOM_BASE_URL=https://api.custom-ai.com/v1
# PROVIDER_CUSTOM_API_KEY=your-api-key-here
# PROVIDER_CUSTOM_MODEL=custom-model-name
# PROVIDER_CUSTOM_REQUIRES_AUTH=true

# ================================================
# Memory Layer Infrastructure
# ================================================
# PostgreSQL credentials used by docker-compose postgres service
POSTGRES_USER=daemon
POSTGRES_PASSWORD=daemon
POSTGRES_DB=daemon

# Memory layer connection URLs
DATABASE_URL=postgresql://daemon:daemon@postgres:5432/daemon
REDIS_URL=redis://redis:6379

# 32-byte base64 encoded key for encrypting memory content
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
DAEMON_ENCRYPTION_KEY=

# Voyage API key for memory embeddings
VOYAGE_API_KEY=

# Memory embedding configuration
# EMBEDDING_DOCUMENT_MODEL=voyage-4-large
# EMBEDDING_QUERY_MODEL=voyage-4-lite
# EMBEDDING_DIMENSIONS=1024

# Background reasoning model for tasks like contradiction detection
# BACKGROUND_REASONING_MODEL=openrouter/deepseek/deepseek-chat

# OpenAI API key used by OpenAI Sora video provider paths
OPENAI_API_KEY=

# Optional: Separate API key for Sora video generation
# Use if you have a different OpenAI account for Sora than default OPENAI_API_KEY
# Falls back to OPENAI_API_KEY if not set
# OPENAI_SORA_API_KEY=

BRAVE_API_KEY=

# ================================================
# Fetch Service (Web content fetching)
# ================================================
# Optional: Jina AI API key for web fetching
# JINA_API_KEY=

# Cache TTL for fetched content in seconds (default: 86400 = 24 hours)
# FETCH_CACHE_TTL_SECONDS=86400

# Minimum content length to consider valid (default: 200 chars)
# FETCH_MIN_CONTENT_LENGTH=200

# Crawl4AI service URL (default: docker-compose service)
# CRAWL4AI_URL=http://crawl4ai:11235

# Comma-separated list of blocked domains (default: empty)
# FETCH_BLOCKED_DOMAINS=

ELEVENLABS_API_KEY=

# xAI API key for Imagine image/video generation
XAI_API_KEY=

# fal.ai API key for Kling video generation
FAL_KEY=

# ================================================
# Auth Configuration
# ================================================
# Environment mode: "production" or "development"
# Production requires strong pepper and rejects insecure cookies.
DAEMON_ENVIRONMENT=development

# Auth pepper for enrollment code HMAC verification.
# Production: must be ≥32 random bytes (≥43 base64url chars). Missing/weak = fails startup.
# Development: if absent, a process-ephemeral pepper is generated with a warning.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DAEMON_AUTH_PEPPER=

# Comma-separated list of allowed CORS origins.
# For local Docker/frontend development, include the frontend origin.
# Examples:
#   DAEMON_ALLOWED_ORIGINS=http://localhost:3000
#   DAEMON_ALLOWED_ORIGINS=https://app.daemon.ai,https://dashboard.daemon.ai
DAEMON_ALLOWED_ORIGINS=http://localhost:3000

# Public origin for CSRF origin validation (e.g., "https://app.daemon.ai").
# This is used to validate Origin header for CSRF protection on cookie-based auth.
DAEMON_PUBLIC_ORIGIN=http://localhost:3000

# Whether to set Secure flag on auth cookies.
# Production: must be true. Development: may be false.
DAEMON_COOKIE_SECURE=false

# ================================================
# Admin Configuration
# ================================================
# Admin API key for admin endpoints (skills admin sync, memory dreaming, video credit grants).
# If set, requires this key for /skills/admin/sync, /memories/dream, /video-credits/grant endpoints
DAEMON_ADMIN_API_KEY=

# ================================================
# Video Credits Configuration
# ================================================

# Video pricing (per-second cost, default: $0.05)
# TIER_PRO_VIDEO_COST_PER_SEC=0.05
# TIER_MAX_VIDEO_COST_PER_SEC=0.04

# ================================================
# Hosted Identity Configuration
# ================================================
# Hosted identity is OFF by default (self-hosted setup-first).
# Set DAEMON_HOSTED_IDENTITY_ENABLED=true to opt in. When enabled in
# production, DAEMON_ENVIRONMENT=production triggers fail-closed validation
# that requires: at least one identity provider enabled, REDIS_URL set,
# DAEMON_MAIL_SENDER_MODE != "console", and (if Google is enabled)
# DAEMON_GOOGLE_CLIENT_ID set.
# DAEMON_HOSTED_IDENTITY_ENABLED=false

# Signup policy: invite_only (default), open, or disabled.
# DAEMON_SIGNUP_MODE=invite_only

# ----- Google provider -----
# DAEMON_GOOGLE_ENABLED=true
# Google OAuth client ID (required when Google is enabled and hosted identity is on).
# DAEMON_GOOGLE_CLIENT_ID=
# Comma-separated additional client IDs for dev/staging audience allowlist.
# DAEMON_GOOGLE_AUDIENCE_ALLOWLIST=

# ----- Email provider -----
# DAEMON_EMAIL_ENABLED=true

# ----- Challenge defaults -----
# Email code TTL in seconds (default 600 = 10 minutes).
# DAEMON_EMAIL_CHALLENGE_TTL_SECONDS=600
# Email code max attempts per challenge (default 5).
# DAEMON_EMAIL_CHALLENGE_MAX_ATTEMPTS=5
# Google nonce challenge TTL in seconds (default 600).
# DAEMON_GOOGLE_NONCE_TTL_SECONDS=600

# ----- Rate-limit thresholds -----
# DAEMON_RATE_LIMIT_EMAIL_START_PER_EMAIL_PER_HOUR=3
# DAEMON_RATE_LIMIT_EMAIL_START_PER_EMAIL_PER_DAY=10
# DAEMON_RATE_LIMIT_EMAIL_START_PER_IP_PER_HOUR=5
# DAEMON_RATE_LIMIT_EMAIL_START_PER_IP_PER_DAY=20
# DAEMON_RATE_LIMIT_EMAIL_COMPLETE_PER_IP_PER_HOUR=20

# ----- Mail sender (dev console sink default; smtp required in production) -----
# DAEMON_MAIL_SENDER_MODE=console
# DAEMON_MAIL_FROM_ADDRESS=noreply@daemon.ai
# DAEMON_MAIL_SMTP_HOST=
# DAEMON_MAIL_SMTP_PORT=587
# DAEMON_MAIL_SMTP_USERNAME=
# DAEMON_MAIL_SMTP_PASSWORD=
# DAEMON_MAIL_SMTP_USE_TLS=true

# ----- Refresh transport knobs -----
# DAEMON_PRIVATE_REFRESH_TTL_DAYS=90
# DAEMON_TEMPORARY_REFRESH_TTL_SECONDS=0

# ----- Hosted identity Redis requirement -----
# DAEMON_HOSTED_IDENTITY_REQUIRE_REDIS=true
