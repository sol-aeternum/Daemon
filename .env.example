# ==============================================================
# Daemon environment example
# ==============================================================
# Every value in this file is a placeholder. Copy it to .env for a deployment,
# fill in the real values, and never commit .env: gitleaks runs in pre-commit
# and in CI.
#
# Layout, in order:
#   1. Secrets              - credentials; blank active lines are the ones the
#                             services need.
#   2. Deployment config    - non-secret settings a deployment normally sets.
#   3. Optional overrides   - commented declarations. The code default in
#                             orchestrator/config.py (or config/video_pricing.py)
#                             applies unless Compose or another environment
#                             source supplies a value with higher precedence.
#
# Two channels feed the backend and the worker: the environment entries in
# docker-compose.yml, and this file bind-mounted at /app/.env. The process
# environment wins over the file, so a name that docker-compose.yml does not
# inject can only be set here, and a name left out of both is resolved from the
# code default.
#
# The frontend reads none of this file. NEXT_PUBLIC_* values are baked into the
# client bundle at image build time, and the DAEMON_* values the Next.js server
# needs must be injected by the frontend service; docker-compose.yml currently
# injects DAEMON_TRUSTED_PROXY_IPS and DAEMON_INTERNAL_PROXY_HMAC_SECRET there.

# ==============================================================
# 1. Secrets
# ==============================================================

# Primary LLM gateway (the default provider fallback).
OPENROUTER_API_KEY=

# OpenAI: embeddings fallback provider.
OPENAI_API_KEY=

# Voyage AI: memory document and query embeddings.
VOYAGE_API_KEY=

# Brave Search: web search tool.
BRAVE_API_KEY=

# ElevenLabs: text to speech, speech to text, sound effects.
ELEVENLABS_API_KEY=

# xAI: image and video generation (Imagine).
XAI_API_KEY=

# fal.ai: Kling video generation.
FAL_KEY=

# Optional Jina Reader API key for the fetch service. Without it the Jina
# strategy is still reachable but sends no bearer token.
# JINA_API_KEY=

# PostgreSQL role, password and database created by the postgres service.
# docker-compose refuses to start when the password is missing or empty;
# generate a unique value before first startup. Known-default passwords are
# also rejected when DAEMON_ENVIRONMENT is production.
POSTGRES_USER=daemon
POSTGRES_PASSWORD=
POSTGRES_DB=daemon

# Explicit database DSN. Leave empty to derive it from the POSTGRES_* values:
# docker-compose injects user, password and database from this file and pins
# the host. Outside Compose the resolver reads those components from the
# process environment only (this file is not loaded for them), so export user,
# password, POSTGRES_HOST and database together; POSTGRES_PORT is optional
# (5432).
DATABASE_URL=

# Redis DSN used for arq jobs and rate limiting.
REDIS_URL=redis://redis:6379

# Fernet key for memory content encryption (32 random bytes, base64 encoded).
# The services read this name; memory startup fails without it.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DAEMON_ENCRYPTION_KEY=

# Diagnostic-only Fernet key. scripts/test_retrieval_quality.py reads this name
# from the process environment (it does not load this file) instead of the one
# above, and falls back to a development-only placeholder when the name is
# absent. Export it with the same generated value in the shell that runs that
# script against encrypted memories; an exported empty value makes the script
# fail instead of falling back. Production memory encryption always uses
# DAEMON_ENCRYPTION_KEY.
# ENCRYPTION_KEY=

# Enrollment-code HMAC pepper. Production requires at least 32 random bytes (43
# or more base64url characters) and refuses to start without it; development
# generates a process-ephemeral pepper and warns. Keep it stable across
# restarts or existing enrollment codes stop verifying.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DAEMON_AUTH_PEPPER=

# Shared secret for the Next.js server proxy to backend HMAC forwarding.
# Required only when DAEMON_TRUST_PROXY_FORWARDED_CLIENT_IP is enabled. Use an
# independent random value of at least 32 characters, share it only between the
# frontend and the backend, do not reuse DAEMON_AUTH_PEPPER, and never expose it
# as NEXT_PUBLIC_*.
# DAEMON_INTERNAL_PROXY_HMAC_SECRET=

# Bearer token for the admin endpoints (/skills/admin/sync, /memories/dream,
# /video-credits/grant). Empty leaves the admin token unusable: admin-gated
# endpoints reject it and the value is not accepted as a device token.
DAEMON_ADMIN_API_KEY=

# Libpq-style password fallback. asyncpg authenticates with it when the
# resolved DSN carries no password, and production startup rejects it when it
# is a known default. Optional; do not remove it from a deployment whose
# DATABASE_URL omits the password.
# PGPASSWORD=

# ==============================================================
# 2. Deployment configuration
# ==============================================================

# Default LLM provider. openrouter is the only built-in provider; an unknown
# name falls back to the openrouter configuration.
DEFAULT_PROVIDER=openrouter

# OpenAI-compatible OpenRouter endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Outbound provider request timeout in seconds.
REQUEST_TIMEOUT_S=90

# Request-body ceilings in bytes. Effective route limits are capped by the
# global ceiling.
DAEMON_MAX_REQUEST_BODY_BYTES=52428800
DAEMON_MAX_CHAT_BODY_BYTES=8388608
DAEMON_MAX_STT_BODY_BYTES=26214400
DAEMON_MAX_SKILL_UPLOAD_BODY_BYTES=52428800

# Preferred SSE keepalive interval in seconds; 0 disables comment-frame
# keepalives. Only used when set, otherwise the legacy alias below applies.
DAEMON_SSE_KEEPALIVE_INTERVAL_S=15

# Legacy alias for the interval above; it applies only when
# DAEMON_SSE_KEEPALIVE_INTERVAL_S is unset. Still read by the code and covered
# by tests, so keep it aligned with the value above.
STREAM_PING_INTERVAL_S=15

# Development: answer with canned streams without calling any provider.
MOCK_LLM=false

# Deprecated runtime label. No behavior reads it today, but it is still a
# declared Settings input and is kept until that field is removed.
ENV=dev

# Application log level.
LOG_LEVEL=INFO

# Chat prompt timezone fallback; saved user timezone preferences take
# precedence. Set Australia/Adelaide here to retain the former deployment-wide
# behavior.
DAEMON_DEFAULT_TIMEZONE=UTC

# Auth environment: production or development. Production requires a strong
# pepper, rejects insecure cookies, and rejects an empty DAEMON_ALLOWED_HOSTS.
# Left commented so a copied file deploys safely: docker-compose falls back to
# production when the name is absent or empty. For a local development stack,
# uncomment this line together with DAEMON_COOKIE_SECURE=false below.
# DAEMON_ENVIRONMENT=development

# Comma-separated browser origins allowed to make cross-origin requests. An
# empty application value denies cross-origin use, but Compose's :- fallback
# replaces an empty root dotenv value with localhost. The value below allows
# only the local frontend.
# List every browser origin explicitly for a multi-domain deployment.
DAEMON_ALLOWED_ORIGINS=http://localhost:3000

# Origin used to validate the Origin header for CSRF protection on
# cookie-based auth, for example the real HTTPS public origin in production.
DAEMON_PUBLIC_ORIGIN=http://localhost:3000

# Secure flag on auth cookies. Production requires true, and docker-compose
# falls back to true when the name is absent or empty. Uncomment only for a
# local development stack served over plain HTTP; the refresh cookie is named
# __Host-daemon_refresh when secure and daemon_refresh when not.
# DAEMON_COOKIE_SECURE=false

# ==============================================================
# 3. Optional overrides
# ==============================================================
# Every declaration in this section is commented on purpose: the code default
# applies unless Compose or another environment source supplies a value.

# ----- Provider routing and model slots -----
# Tier used when a request does not resolve one (free, starter, pro, max, byok).
# DEFAULT_TIER=pro

# Auto-routing slots: the fast model for cheap turns and the reasoning model
# for harder turns, plus their Grok alternatives.
# AUTO_FAST_MODEL=openrouter/google/gemini-2.5-flash
# AUTO_FAST_TEMP=0.7
# AUTO_FAST_MODEL_GROK=x-ai/grok-4.1-fast
# AUTO_FAST_MODEL_GROK_TEMP=0.7
# AUTO_REASONING_MODEL=openrouter/moonshotai/kimi-k2.5
# AUTO_REASONING_TEMP=0.7

# OpenRouter attribution headers. Keep them if you operate a public instance.
# OPENROUTER_REFERER=https://daemon.ai
# OPENROUTER_TITLE=Daemon AI Assistant

# OpenRouter image-generation model.
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Conversation-title generation model.
# TITLE_MODEL=openrouter/openai/gpt-4o-mini

# Model for background reasoning such as contradiction detection.
# BACKGROUND_REASONING_MODEL=openrouter/deepseek/deepseek-chat

# Provider-level reasoning/thinking parameters, keyed by model prefix. JSON
# object; uncommenting replaces the whole code default, so copy the default
# from orchestrator/config.py and edit it rather than starting from an empty
# object.
# PROVIDER_EXTRA_PARAMS={"openrouter/anthropic/": {"reasoning": {"enabled": true}}, "openrouter/openai/": {"reasoning_effort": "medium"}, "openrouter/google/": {"reasoning": {"max_tokens": 4096}}, "anthropic/": {"thinking": {"type": "adaptive", "effort": "medium"}}, "openai/responses/": {"reasoning_effort": "medium"}}

# Per-model overrides keyed by exact model id; these win over the provider
# prefixes above. JSON object, same replacement rule.
# MODEL_EXTRA_PARAMS={"openrouter/anthropic/claude-opus-4.6": {"reasoning": {"max_tokens": 16000}, "verbosity": "max"}, "openrouter/anthropic/claude-sonnet-4.6": {"reasoning": {"max_tokens": 16000}, "verbosity": "max"}}

# Declared CORS origin list. No application code reads this field today; the
# effective allowlist is DAEMON_ALLOWED_ORIGINS above. Kept documented because
# the Settings field still exists and is env-configurable.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# Custom providers are not supported: the resolver looks for
# PROVIDER_{NAME}_* names, but undeclared fields are ignored by configuration
# parsing, so those variables never take effect and an unknown provider name
# falls back to openrouter. Repairing or removing that path is tracked as
# separate work; do not add PROVIDER_CUSTOM_* declarations here.

# ----- Conversation and admin limits -----
# Conversation history rows loaded per request.
# CHAT_HISTORY_LIMIT=50

# Largest credit grant a single admin request may create.
# DAEMON_MAX_GRANT_AMOUNT_PER_REQUEST=100

# Minimum length of an admin credit-grant description.
# DAEMON_MIN_GRANT_DESCRIPTION_LENGTH=5

# Address that receives alerts for repeated failures of critical background
# jobs. Alerts use the configured mail sender, so a console or disabled sender
# never delivers them.
# DAEMON_WORKER_FAILURE_ALERT_EMAIL=

# ----- Host allowlist and setup token -----
# Comma-separated Host header values accepted by the trusted-host middleware;
# *.example.com wildcards are supported. Empty means "any host" in development
# and is rejected at startup in production, so set the real external and
# internal hostnames before enabling production.
# DAEMON_ALLOWED_HOSTS=

# File that holds the one-time first-boot setup token.
# DAEMON_SETUP_TOKEN_FILE=.daemon/setup-token

# ----- Memory embeddings -----
# EMBEDDING_DOCUMENT_MODEL=voyage-4-large
# EMBEDDING_QUERY_MODEL=voyage-4-lite
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_FALLBACK_PROVIDERS=openrouter,openai
# EMBEDDING_OPENROUTER_DOCUMENT_MODEL=voyageai/voyage-4-large
# EMBEDDING_OPENROUTER_QUERY_MODEL=voyageai/voyage-4-lite
# EMBEDDING_OPENAI_FALLBACK_MODEL=text-embedding-3-small

# ----- Memory dedup thresholds -----
# Bands applied to embedding similarity: merge at or above the merge floor,
# supersede at or above the supersede floor, slot-constrained supersede at or
# above the lower floor, otherwise insert a new memory. Raise the merge floor
# above the observed within-scenario similarity maximum to avoid false merges.
# DEDUP_MERGE_THRESHOLD=0.9
# DEDUP_SUPERSEDE_THRESHOLD=0.82
# DEDUP_SUPERSEDE_SAME_SLOT_THRESHOLD=0.65

# ----- Memory dreaming and consolidation -----
# Autonomous clustering of memories.
# DREAMING_ENABLED=true
# DREAM_SCHEDULE_HOUR=3
# DREAM_MIN_CLUSTER_SIZE=5

# Periodic memory consolidation interval in days (1 or 7).
# CONSOLIDATION_ENABLED=true
# CONSOLIDATION_INTERVAL_DAYS=7

# Skill-consolidation nudge: enabled by default.
# CONSOLIDATION_NUDGE_ENABLED=true
# Conversations between nudge runs per user.
# CONSOLIDATION_NUDGE_CONVERSATION_INTERVAL=15
# Days of inactivity before a skill counts as stale.
# CONSOLIDATION_NUDGE_STALE_DAYS=30
# Minimum autonomous skills before the nudge evaluates merge potential.
# CONSOLIDATION_NUDGE_MIN_SKILLS=3

# Retrieval trajectory logging. Forced on for benchmark runs; the debug flag also
# enables verbose retrieval debug output.
# RETRIEVAL_LOGGING_ENABLED=false
# RETRIEVAL_LOGGING_DEBUG=false

# ----- Fetch service (web content fetching) -----
# Direct requests identify Daemon consistently; override for an explicit
# integration. A custom value emits a warning when the direct strategy starts.
# A contact URL can be included; the value must be printable ASCII.
# DAEMON_FETCH_USER_AGENT="Daemon (+https://github.com/sol-aeternum/Daemon)"

# Cache TTL for fetched content in seconds (86400 = 24 hours).
# FETCH_CACHE_TTL_SECONDS=86400

# Minimum content length to consider valid, in characters.
# FETCH_MIN_CONTENT_LENGTH=200

# Crawl4AI service URL (defaults to the docker-compose service).
# CRAWL4AI_URL=http://crawl4ai:11235

# Comma-separated blocked domains (empty blocks nothing).
# FETCH_BLOCKED_DOMAINS=

# Comma-separated MIME content types the fetcher will accept, on top of the
# types the caller asks for. Empty adds no extra restriction.
# FETCH_ALLOWED_CONTENT_TYPES=

# Maximum crawl depth passed to the fetcher. Unset means no depth constraint,
# so set an integer rather than an empty value if you want a bound.
# FETCH_MAX_DEPTH=3

# Comma-separated substrings that identify short error pages such as "not
# found" or "access denied". Empty disables signature-based rejection.
# FETCH_ERROR_SIGNATURES=not found,access denied

# Egress allowlist applied on top of the SSRF address-range checks. Empty
# applies no allowlist filter; wildcards use the *.example.com form.
# DAEMON_HTTP_ALLOWED_DOMAINS=

# ----- Video credit pricing -----
# Credit costs per duration and per-tier discount factors, in credits
# (1 credit = $0.05). VIDEO_COST_* are integer credit amounts, not dollars per
# second, and VIDEO_TIER_*_DISCOUNT is a multiplier applied to the credit cost.
# VIDEO_CREDITS_PER_SECOND=1
# VIDEO_COST_5S=5
# VIDEO_COST_10S=10
# VIDEO_COST_15S=15
# VIDEO_COST_20S=20
# VIDEO_COST_30S=30
# VIDEO_TIER_PRO_DISCOUNT=1.0
# VIDEO_TIER_MAX_DISCOUNT=0.8
# VIDEO_TIER_BYOK_DISCOUNT=0.0

# ----- Hosted identity and auth providers -----
# Hosted identity is OFF by default (self-hosted, setup-first). Enabling it in
# production triggers fail-closed validation that requires at least one identity
# provider, a Redis URL, a real mail sender when email is enabled, and (with
# Google enabled) a Google client ID.
# DAEMON_HOSTED_IDENTITY_ENABLED=false
# Deployment mode: self_hosted (default) or hosted. self_hosted sends
# unauthenticated users to /setup and keeps /v1/auth/setup usable; hosted sends
# them to /auth and blocks /v1/auth/setup.
# DAEMON_DEPLOYMENT_MODE=self_hosted
# Signup policy: invite_only (default), open, or disabled.
# DAEMON_SIGNUP_MODE=invite_only
# Google account sign-in. Also works on localhost, so no SMTP is required.
# DAEMON_GOOGLE_ENABLED=true
# Google OAuth web client ID, required when Google is enabled under hosted
# identity.
# DAEMON_GOOGLE_CLIENT_ID=
# Additional client IDs for a dev/staging audience allowlist.
# DAEMON_GOOGLE_AUDIENCE_ALLOWLIST=
# Email code sign-in.
# DAEMON_EMAIL_ENABLED=true
# Mail sender: console (default), smtp, or disabled.
# DAEMON_MAIL_SENDER_MODE=console
# To run a Google-only hosted deployment, switch the mode to hosted, turn
# hosted identity on, set the signup policy to open, keep Google enabled with a
# client ID, and turn email off with the mail sender disabled. Register
# http://localhost and http://localhost:3000 as Google JavaScript origins;
# Google's audience and testing restrictions apply independently of the signup
# policy.

# ----- Challenge defaults -----
# Email code TTL in seconds (600 = 10 minutes).
# DAEMON_EMAIL_CHALLENGE_TTL_SECONDS=600
# Email code max attempts per challenge.
# DAEMON_EMAIL_CHALLENGE_MAX_ATTEMPTS=5
# Google nonce challenge TTL in seconds.
# DAEMON_GOOGLE_NONCE_TTL_SECONDS=600

# ----- Rate-limit thresholds -----
# DAEMON_RATE_LIMIT_EMAIL_START_PER_EMAIL_PER_HOUR=3
# DAEMON_RATE_LIMIT_EMAIL_START_PER_EMAIL_PER_DAY=10
# DAEMON_RATE_LIMIT_EMAIL_START_PER_IP_PER_HOUR=5
# DAEMON_RATE_LIMIT_EMAIL_START_PER_IP_PER_DAY=20
# DAEMON_RATE_LIMIT_EMAIL_COMPLETE_PER_IP_PER_HOUR=20
# Chat limits use independent 60-second Redis windows. The per-IP coarse ceiling
# applies to all chat attempts (including malformed or unauthenticated
# requests) to stay usable behind CGNAT; authenticated requests are also bounded
# per session and per user. These three thresholds are backend-only.
# DAEMON_RATE_LIMIT_CHAT_PER_TOKEN_PER_MINUTE=30
# DAEMON_RATE_LIMIT_CHAT_PER_USER_PER_MINUTE=60
# DAEMON_RATE_LIMIT_CHAT_PER_IP_PER_MINUTE=120

# ----- Mail sender (SMTP is required in production only when email is enabled) -----
# DAEMON_MAIL_FROM_ADDRESS=noreply@daemon.ai
# DAEMON_MAIL_SMTP_HOST=
# DAEMON_MAIL_SMTP_PORT=587
# DAEMON_MAIL_SMTP_USERNAME=
# DAEMON_MAIL_SMTP_PASSWORD=
# DAEMON_MAIL_SMTP_USE_TLS=true

# ----- Trusted auth proxy forwarding -----
# Backend default safe posture is false: identity rate limits key on the
# immediate socket IP. Set true only when the backend is reached through the
# Next.js server proxy routes (including /api/chat and /api/v1/auth/*) over a
# trusted private or loopback hop. It is also what makes
# DAEMON_INTERNAL_PROXY_HMAC_SECRET meaningful.
# DAEMON_TRUST_PROXY_FORWARDED_CLIENT_IP=false
# Frontend server proxy: comma-separated immediate proxy IPs allowed to supply
# X-Forwarded-For and platform client-IP headers. Leave unset for
# direct/self-hosted deployments; spoofed forwarded headers are ignored unless
# x-real-ip is in this allowlist.
# DAEMON_TRUSTED_PROXY_IPS=

# ----- Refresh transport knobs -----
# DAEMON_PRIVATE_REFRESH_TTL_DAYS=90
# DAEMON_TEMPORARY_REFRESH_TTL_SECONDS=0

# ----- Session cleanup safety -----
# Cleanup interval in seconds (86400 = daily).
# DAEMON_SESSION_CLEANUP_INTERVAL_SECONDS=86400
# Grace period must be >= 1. Cleanup aborts on larger tables if one run would
# delete more than this fraction of sessions.
# DAEMON_SESSION_CLEANUP_GRACE_DAYS=7
# DAEMON_SESSION_CLEANUP_MAX_DELETE_FRACTION=0.5

# ----- Hosted identity Redis requirement -----
# DAEMON_HOSTED_IDENTITY_REQUIRE_REDIS=true

# ----- Frontend build and server variables -----
# Public backend URL baked into the browser bundle at image build time.
# docker-compose interpolates it as a build argument and falls back to
# http://localhost:8000, while the frontend service pins the runtime value to
# http://localhost:8000. Set it before building an image for a real deployment.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only upstream override for the Next.js route handlers. When unset they
# use NEXT_PUBLIC_API_URL or a handler-specific default, usually
# http://backend:8000. docker-compose does not forward this name into the
# frontend service today, so setting it here alone has no effect.
# DAEMON_INTERNAL_API_URL=http://backend:8000

# Legacy frontend hosted-identity build arguments. These NEXT_PUBLIC_* values
# remain for compatibility with existing images and development tests.
# GET /v1/auth/config is authoritative: configure DAEMON_DEPLOYMENT_MODE and the
# provider settings on the backend instead. If the runtime endpoint is
# unavailable or invalid, /auth shows a retryable error rather than falling back
# to these values or to first-boot setup.
# NEXT_PUBLIC_DAEMON_DEPLOYMENT_MODE=self-hosted

# Legacy public Google OAuth web client id build argument. Runtime provider
# availability and client id come from DAEMON_GOOGLE_CLIENT_ID through
# GET /v1/auth/config; never share the client secret here.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Legacy public hosted email-provider build argument. Runtime availability comes
# from DAEMON_EMAIL_ENABLED through GET /v1/auth/config.
# NEXT_PUBLIC_EMAIL_ENABLED=true

# ----- Database resolver components -----
# Components of the DSN that resolve_database_url() derives when DATABASE_URL
# is empty. docker-compose sets the host itself for the Python services, so
# these are for standalone runs, which read them from the process environment
# rather than this file: export them in the shell that runs the script.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# ----- Standalone maintenance scripts -----
# Directory for pg_dump output written by scripts/backup_db.py (relative paths
# resolve against the current working directory). Read from the process
# environment, not this file.
# BACKUP_DIR=backups
