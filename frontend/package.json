{
  "name": "daemon-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "type-check": "next typegen && tsc --noEmit",
    "audit:ci": "npm audit --audit-level=high",
    "security:braces": "node scripts/check-braces-security.cjs && node --test scripts/check-braces-security-negative.cjs && node --test scripts/watch-braces-upstream.test.cjs && npm ci --prefix vendor/braces-test-tools --ignore-scripts && npm audit --prefix vendor/braces-test-tools --audit-level=high && node vendor/braces-test-tools/node_modules/mocha/bin/mocha.js --no-config --no-package --require ./scripts/braces-upstream-loader.cjs --reporter dot \"vendor/braces/test/*.js\"",
    "security:braces:watch": "node scripts/watch-braces-upstream.cjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "playwright test",
    "test:browser:qualification": "node e2e/run-ui-qualification.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.61",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/typography": "^0.5.19",
    "ai": "^7.0.58",
    "braces": "file:vendor/daemon-internal-braces-3.0.3-daemon.2.tgz",
    "docx-preview": "^0.3.7",
    "dompurify": "3.4.17",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.563.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "playwright": "^1.61.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "postcss": "8.5.23",
    "prettier": "^3.8.3",
    "serwist": "^9.5.12",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "browserslist": "4.29.0",
    "braces": "$braces",
    "ai": {
      "zod": "4.6.6"
    },
    "@ai-sdk/mcp": {
      "zod": "4.6.6"
    },
    "@ai-sdk/provider-utils": {
      "zod": "4.6.6",
      "undici": "7.30.1"
    },
    "@serwist/next": {
      "zod": "4.6.6"
    },
    "eslint-config-next": {
      "eslint-plugin-react-hooks": {
        ".": "7.1.0",
        "zod": "4.6.6"
      },
      "typescript-eslint": "8.56.0"
    },
    "vitest": {
      "vite": "7.3.7"
    },
    "@vitejs/plugin-react": {
      "vite": "7.3.7"
    },
    "ajv@8.20.0": {
      "fast-uri": "3.1.9"
    },
    "next": {
      "sharp": "0.35.5"
    },
    "postcss@8.5.23": {
      "source-map-js": "1.2.2"
    },
    "css-tree@3.2.1": {
      "source-map-js": "1.2.2"
    }
  }
}
