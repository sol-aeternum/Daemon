  "parity_exceptions": [
    {
      "id": "query_source",
      "difference": "The question text stands in for the latest user message; production derives the query from the conversation's recent messages.",
      "impact": "Same normalisation and retrieval call; no prior turns in the query."
    },
    {
      "id": "benchmark_users",
      "difference": "Each question's haystack is ingested into its own benchmark user, in haystack-date order; a session shared by several questions is ingested once per question.",
      "impact": "Each user's memory holds one history, as in production and LongMemEval; retrieval reads all of that user's memories, unscoped."
    },
    {
      "id": "read_only_evaluate",
      "difference": "Evaluate disables trust recording and memory access touches (record_side_effects=False, touch_results=False).",
      "impact": "Production updates access_count/last_accessed_at, which feed later ranking; the harness keeps every question on the ingest state."
    },
    {
      "id": "retrieval_log_label",
      "difference": "Retrieval logging is forced on with retrieval_triggered_by='longmemeval'.",
      "impact": "Diagnostics only; retrieval_log is not a ranking input."
    },
    {
      "id": "system_prompt_extras",
      "difference": "The answer prompt is compose_system_prompt(memory_context) with no preferences, skills index, answer controls or tools.",
      "impact": "The memory block and base Daemon prompt match production; the answer model cannot call memory tools to fetch more."
    },
    {
      "id": "answer_judge_models",
      "difference": "Answers and judgments use the pinned benchmark route (openrouter/openai/gpt-4o-2024-08-06, temperature 0, seed 42), not the production chat route.",
      "impact": "Measures memory surface with a fixed reader; not end-to-end product quality."
    },
    {
      "id": "no_post_extraction_jobs",
      "difference": "Ingest runs extraction and dedup only: no entity resolution, conversation summaries, dreaming or consolidation jobs.",
      "impact": "Entity expansion and summaries are empty; production would have them."
    },
    {
      "id": "message_timestamps",
      "difference": "Haystack messages are stored at ingest time, not at the dataset's session dates, and retrieval runs with query_reference_time=None.",
      "impact": "Recency and temporal windows see the ingest clock; temporal questions are disadvantaged relative to real usage."
    }
  ],
